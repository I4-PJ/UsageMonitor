<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UsageMonitor.ViewModels"
        xmlns:models="using:UsageMonitor.Models"
        xmlns:controls="using:UsageMonitor.Controls"
        x:Class="UsageMonitor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/AppIcon.ico"
        Title="Codex Usage Monitor"
        Width="900"
        Height="720"
        MinWidth="760"
        MinHeight="560"
        Background="#0B0F14"
        Foreground="#F2F6FA">
    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#8E9BAC"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="Foreground" Value="#F2F6FA"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.overline">
            <Setter Property="Foreground" Value="#8E9BAC"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="1.1"/>
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#131922"/>
            <Setter Property="BorderBrush" Value="#222C38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style Selector="Border.windowTile">
            <Setter Property="Background" Value="#0F141C"/>
            <Setter Property="BorderBrush" Value="#202A36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="#78E0BE"/>
            <Setter Property="Foreground" Value="#09251D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#91E9CC"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <Border BorderBrush="#202834" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" Margin="26,20">
                <StackPanel Spacing="5">
                    <TextBlock Text="Codex quota" FontSize="21" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="●" Foreground="{Binding StatusColor}" FontSize="10" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" Classes="muted"/>
                        <TextBlock Text="·" Classes="muted"/>
                        <TextBlock Text="{Binding LastUpdatedText}" Classes="muted"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Refresh every" Classes="muted" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding RefreshIntervalOptions}"
                              SelectedItem="{Binding SelectedRefreshIntervalOption, Mode=TwoWay}"
                              MinWidth="116"
                              Height="34"
                              CornerRadius="7"
                              FontSize="12"
                              Background="#131922"
                              BorderBrush="#2A3543"
                              AutomationProperties.Name="Auto-refresh interval">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:RefreshIntervalOption">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Classes="primary"
                            Command="{Binding RefreshCommand}"
                            Content="Refresh"
                            AutomationProperties.Name="Refresh quota"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="26,24,26,34" Spacing="24">
                <Border Background="#28191C"
                        BorderBrush="#593038"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="15,13"
                        IsVisible="{Binding HasRefreshError}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Width="7" Height="7" CornerRadius="4" Background="#FF8A84"
                                VerticalAlignment="Top" Margin="0,5,0,0"/>
                        <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,0,0">
                            <TextBlock Text="Quota could not be updated" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding RefreshErrorText}" Classes="muted"
                                       Foreground="#D9A8A7" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" Margin="2,0">
                        <TextBlock Text="Current limits" Classes="sectionTitle"/>
                        <TextBlock Grid.Column="1" Text="Remaining budget" Classes="muted" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Classes="panel" IsVisible="{Binding !HasQuota}">
                        <StackPanel Spacing="6" Margin="2">
                            <TextBlock Text="No quota data yet" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Refresh to read the quota windows linked to your Codex account."
                                       Classes="muted" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Limits}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:QuotaLimitViewModel">
                                <Border Classes="panel" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding StatusText}" Classes="muted"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#1C2733" CornerRadius="6"
                                                    Padding="9,4" IsVisible="{Binding !!PlanType}"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding PlanType}" FontSize="10" Foreground="#BAC7D5"/>
                                            </Border>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Windows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:QuotaWindowViewModel">
                                                    <Border Classes="windowTile">
                                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                                            <StackPanel Spacing="3">
                                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium"/>
                                                                <TextBlock Text="{Binding ResetText}" Classes="muted"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding RemainingText}" FontSize="24"
                                                                           FontWeight="SemiBold" Foreground="#F5F8FB"/>
                                                                <TextBlock Text="left" Classes="muted" VerticalAlignment="Bottom"
                                                                           Margin="0,0,0,4"/>
                                                            </StackPanel>
                                                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                                                                         Minimum="0" Maximum="100" Height="7"
                                                                         Margin="0,13,0,0" CornerRadius="4"
                                                                         Value="{Binding ProgressValue}"
                                                                         Foreground="#78E0BE" Background="#283341"
                                                                         AutomationProperties.Name="Quota remaining"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" Margin="2,0">
                        <TextBlock Text="Forecast" Classes="sectionTitle"/>
                        <TextBlock Grid.Column="1" Text="Based on saved quota history" Classes="muted"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <Border Classes="panel">
                        <Grid ColumnDefinitions="4,*">
                            <Border Background="#78E0BE" CornerRadius="2"/>
                            <StackPanel Grid.Column="1" Spacing="6" Margin="15,1,0,1">
                                <TextBlock Text="{Binding HeadlineForecastTitle}" Classes="overline"/>
                                <TextBlock Text="{Binding HeadlineForecastText}" FontSize="17" FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding HeadlineForecastDetail}" Classes="muted" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" Margin="2,0">
                        <TextBlock Text="History" Classes="sectionTitle"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14">
                            <TextBlock Text="●  Remaining" Foreground="#78E0BE" FontSize="11"/>
                            <TextBlock Text="┄  Forecast" Foreground="#7FA8FF" FontSize="11"/>
                            <TextBlock Text="│  Reset" Foreground="#E9BD70" FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <Border Classes="panel" IsVisible="{Binding !HasHistoryCharts}">
                        <TextBlock Text="{Binding HistoryStatusText}" Classes="muted" TextWrapping="Wrap"/>
                    </Border>

                    <ItemsControl ItemsSource="{Binding HistoryCharts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:QuotaHistoryChartViewModel">
                                <Border Classes="panel" Margin="0,0,0,10">
                                    <StackPanel Spacing="7">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CurrentStatus}" FontSize="14"
                                                       Foreground="#78E0BE" FontWeight="SemiBold" Margin="14,0,0,0"/>
                                        </Grid>
                                        <TextBlock Text="{Binding ForecastText}" Foreground="#B4CAFF" FontSize="13"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ForecastDetail}" Classes="muted" TextWrapping="Wrap"/>
                                        <Grid ColumnDefinitions="34,*" Height="166" Margin="0,12,0,0">
                                            <Grid RowDefinitions="Auto,*,Auto">
                                                <TextBlock Text="100" Classes="muted" FontSize="9"/>
                                                <TextBlock Grid.Row="1" Text="50" Classes="muted" FontSize="9"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="2" Text="0" Classes="muted" FontSize="9"/>
                                            </Grid>
                                            <controls:QuotaHistoryChart Grid.Column="1"
                                                ObservedPoints="{Binding ObservedPoints}"
                                                ForecastPoints="{Binding ForecastPoints}"
                                                ResetTimesUtc="{Binding ResetTimesUtc}"
                                                RangeStartUtc="{Binding RangeStartUtc}"
                                                RangeEndUtc="{Binding RangeEndUtc}"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" Margin="34,0,0,0">
                                            <TextBlock Text="{Binding RangeStartText}" Classes="muted" FontSize="9"/>
                                            <TextBlock Grid.Column="1" Text="{Binding RangeEndText}" Classes="muted" FontSize="9"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding HistoryStatusText}" Classes="muted" TextWrapping="Wrap"
                               Margin="2,0" IsVisible="{Binding HasHistoryCharts}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
