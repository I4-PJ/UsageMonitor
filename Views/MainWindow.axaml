<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UsageMonitor.ViewModels"
        xmlns:models="using:UsageMonitor.Models"
        xmlns:controls="using:UsageMonitor.Controls"
        x:Class="UsageMonitor.Views.MainWindow" x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/AppIcon.ico" Title="Codex Usage Monitor"
        Width="820" Height="660" MinWidth="720" MinHeight="540"
        Background="#0C1016" Foreground="#EDF2F8">
    <Design.DataContext><vm:MainWindowViewModel/></Design.DataContext>
    <Window.Styles>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#98A6B9"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="Foreground" Value="#97ADCA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="0"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#141B25"/>
            <Setter Property="BorderBrush" Value="#243041"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="Foreground" Value="#A5B3C6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="TabSurface" Background="#131A24" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Header}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabItem:pointerover /template/ Border#TabSurface">
            <Setter Property="Background" Value="#202C3C"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#D3FCEE"/>
        </Style>
        <Style Selector="TabItem:selected /template/ Border#TabSurface">
            <Setter Property="Background" Value="#203C38"/>
        </Style>
        <Style Selector="TabItem:focus-visible /template/ Border#TabSurface">
            <Setter Property="BorderBrush" Value="#76E3C0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20,18,20,14">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <TextBlock Text="Codex Usage" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="Auto-refresh" Classes="muted" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding RefreshIntervalOptions}"
                          SelectedItem="{Binding SelectedRefreshIntervalOption, Mode=TwoWay}"
                          MinWidth="120" Height="32" CornerRadius="8" FontSize="12"
                          Background="#17212E" BorderBrush="#2B3B50"
                          AutomationProperties.Name="Auto-refresh interval">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:RefreshIntervalOption">
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Command="{Binding RefreshCommand}" Height="32" Padding="16,0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        CornerRadius="8" Background="#ACF2DA" Foreground="#102C25"
                        FontWeight="SemiBold" FontSize="12" Content="Refresh"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" CornerRadius="8" Background="#15221F"
                BorderBrush="#2A3C36" BorderThickness="1" Padding="14,12" Margin="0,0,0,16">
            <StackPanel Spacing="5">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Estimated depletion" Classes="muted" Foreground="#A6C7BB"/>
                    <TextBlock Grid.Column="1" Text="{Binding HeadlineForecastTitle}" Classes="muted"/>
                </Grid>
                <TextBlock Text="{Binding HeadlineForecastText}" FontSize="14" FontWeight="SemiBold"
                           Foreground="#D8F1E7" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding HeadlineForecastDetail}" Classes="muted" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="Overview" AutomationProperties.Name="Overview">
                <ScrollViewer Margin="0,14,0,0" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,10">
                            <TextBlock Text="Available budget" Classes="eyebrow"/>
                            <TextBlock Grid.Column="1" Text="{Binding SummaryText}" Classes="muted"
                                       MaxWidth="400" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding SummaryText}"/>
                        </Grid>
                        <Border Classes="card" IsVisible="{Binding !HasQuota}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Waiting for current quota" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Refresh to load the latest available budget. Saved history is available in the second tab."
                                           Classes="muted" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Limits}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:QuotaLimitViewModel">
                                    <Border Classes="card">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="1" Background="#253044" CornerRadius="6"
                                                        Padding="9,4" IsVisible="{Binding !!PlanType}">
                                                    <TextBlock Text="{Binding PlanType}" FontSize="11" Foreground="#C3D1E7"/>
                                                </Border>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Windows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:QuotaWindowViewModel">
                                                        <Grid RowDefinitions="Auto,Auto" Margin="0,3,0,7">
                                                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="#CCD7E6"/>
                                                                    <TextBlock Text="{Binding ResetText}" Classes="muted"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Bottom">
                                                                    <TextBlock Text="{Binding RemainingText}" FontSize="16" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="left" Classes="muted" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Grid>
                                                            <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Height="6"
                                                                         CornerRadius="3" Value="{Binding ProgressValue}"
                                                                         Foreground="#76E3C0" Background="#293446"
                                                                         AutomationProperties.Name="Quota remaining"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="History &amp; forecast" AutomationProperties.Name="History &amp; forecast">
                <ScrollViewer Margin="0,14,0,0" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,10">
                            <TextBlock Text="Budget over time" Classes="eyebrow"/>
                            <TextBlock Grid.Column="1" Text="Past 14 days · hourly" Classes="muted"/>
                        </Grid>
                        <WrapPanel Margin="2,0,0,16">
                            <TextBlock Text="●  Remaining" Foreground="#76E3C0" FontSize="11" Margin="0,0,20,0"/>
                            <TextBlock Text="┄  Forecast" Foreground="#8CB5FF" FontSize="11" Margin="0,0,20,0"/>
                            <TextBlock Text="│  Reset" Foreground="#E5B96D" FontSize="11"/>
                        </WrapPanel>
                        <TextBlock Text="No quota-window history is available yet." IsVisible="{Binding !HasHistoryCharts}"
                                   Classes="muted" Margin="0,12,0,24"/>
                        <ItemsControl ItemsSource="{Binding HistoryCharts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:QuotaHistoryChartViewModel">
                                    <Border Classes="card">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding CurrentStatus}" FontSize="14"
                                                           Foreground="#76E3C0" FontWeight="SemiBold" Margin="12,0,0,0"/>
                                            </Grid>
                                            <TextBlock Text="{Binding ForecastText}" Foreground="#AFCBFF" FontSize="14" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding ForecastDetail}" Classes="muted" TextWrapping="Wrap"/>
                                            <Grid ColumnDefinitions="40,*" Height="170" Margin="0,16,0,2">
                                                <Grid RowDefinitions="Auto,*,Auto">
                                                    <TextBlock Text="100%" Classes="muted" FontSize="10"/>
                                                    <TextBlock Grid.Row="1" Text="50%" Classes="muted" FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Row="2" Text="0%" Classes="muted" FontSize="10"/>
                                                </Grid>
                                                <controls:QuotaHistoryChart Grid.Column="1"
                                                    ObservedPoints="{Binding ObservedPoints}" ForecastPoints="{Binding ForecastPoints}"
                                                    ResetTimesUtc="{Binding ResetTimesUtc}" RangeStartUtc="{Binding RangeStartUtc}"
                                                    RangeEndUtc="{Binding RangeEndUtc}"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto" Margin="40,0,0,0">
                                                <TextBlock Text="{Binding RangeStartText}" Classes="muted" FontSize="10"/>
                                                <TextBlock Grid.Column="1" Text="{Binding RangeEndText}" Classes="muted" FontSize="10"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding HistoryStatusText}" Classes="muted" TextWrapping="Wrap" Margin="2,2,0,14"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="3" BorderBrush="#243041" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,8,0,0">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Text="{Binding StatusText}" Classes="muted" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="1" Text="{Binding LastUpdatedText}" Classes="muted"/>
                <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,7,0,0">
                    <TextBlock Text="{Binding TodayTokensText}" Classes="muted" FontSize="11" Margin="0,0,20,0"/>
                    <TextBlock Text="{Binding ResetCreditsText}" Classes="muted" FontSize="11"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
